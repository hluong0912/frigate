# Copy to /etc/frigate-offload.env on the NVR host.

# Frigate's recordings folder on the host (FRIGATE_MEDIA_DIR + /recordings).
RECORD_DIR=/mnt/chnvme/frigate/media/recordings

# Synology NFS share already mounted on .249 at /mnt/archive; footage goes to /mnt/archive/frigate.
# The job refuses to run unless this is a live mount point.
NAS_MOUNT=/mnt/archive
# Subfolder on the NAS for recordings. Layout mirrors Frigate's:
# <NAS_MOUNT>/<NAS_SUBDIR>/YYYY-MM-DD/HH/<camera>/MM.SS.mp4
NAS_SUBDIR=frigate/recordings

# Start offloading when local recordings exceed HIGH_WATER_GB,
# and keep moving the oldest hours until usage is under LOW_WATER_GB.
#   .182 profile (40GB local):   HIGH_WATER_GB=30  LOW_WATER_GB=25
#   .249 profile (100GB local):  HIGH_WATER_GB=70  LOW_WATER_GB=60
HIGH_WATER_GB=70
LOW_WATER_GB=60

# Never touch hours newer than this (Frigate may still be writing them).
MIN_AGE_MINUTES=90

# After moving files, ask Frigate to drop DB rows for the moved segments
# so the timeline doesn't show local footage that's no longer there.
# Set to empty to skip.
FRIGATE_API=http://127.0.0.1:5001
