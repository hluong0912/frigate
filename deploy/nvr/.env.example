# Copy to .env on the NVR host and fill in. Never commit the real .env.

# --- Frigate host -----------------------------------------------------------
# Image tag. The zmq detector needs Frigate 0.17 or newer.
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:stable
TZ=America/Los_Angeles
# Where recordings live on the host. Ideally a dedicated virtual disk sized to
# the local cap (40G on .182, 100G on .249), so the cap is enforced by the
# filesystem as well as by the offload job.
FRIGATE_MEDIA_DIR=/srv/frigate/media
FRIGATE_CONFIG_DIR=/srv/frigate/config
# Shared memory for decoded frames. ~40MB per 1080p detect stream is plenty.
FRIGATE_SHM_SIZE=512mb
# Port the offload job uses to tell Frigate about moved files. Bound to
# 127.0.0.1 only. (.182 already has something on 5000, so use 5001.)
FRIGATE_LOCAL_API_PORT=5001

# Camera credentials, referenced in config.yml as {FRIGATE_RTSP_USER} etc.
FRIGATE_RTSP_USER=CHANGE_ME
FRIGATE_RTSP_PASSWORD=CHANGE_ME

# --- DGX Spark (all object detection runs there) ---------------------------
# Referenced in config.yml as tcp://{FRIGATE_SPARK_HOST}:{FRIGATE_SPARK_PORT}
FRIGATE_SPARK_HOST=CHANGE_ME_SPARK_IP
FRIGATE_SPARK_PORT=5555
